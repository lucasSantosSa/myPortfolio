# Contact form delivery (set these in the hosting provider, never commit real values)

# Email via Resend (https://resend.com): API key and where messages go
RESEND_API_KEY=
CONTACT_TO_EMAIL=lucas.s.sa@hotmail.com
# Sender; must be a domain verified in Resend. The default works only for the account owner's own address.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# WhatsApp via CallMeBot (https://www.callmebot.com/blog/free-api-whatsapp-messages/)
# Phone in international format without "+", and the API key CallMeBot sends you
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=
